# Complete chat-completions endpoint: no path is appended.
LLM_ENDPOINT_URL=https://model-service.example/v1/chat/completions
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model-name

# Existing OPENAI_API_BASE_URL, OPENAI_API_KEY and OPENAI_API_MODEL are supported.
# Despite its legacy name, OPENAI_API_BASE_URL is used literally as a full endpoint.
# Do not set conflicting canonical and legacy values.

# Optional; also enable the matching override in config/workbench.toml.
# SWE_LLM_MODEL=another-model
# SWE_LLM_ENDPOINT_URL=https://another-service.example/chat/completions
# SWE_LLM_API_KEY=replace-with-that-services-key
